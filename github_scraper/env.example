from app.utils.security import is_sensitive_path, redact_secrets


def test_sensitive_paths():
    assert is_sensitive_path(".env")
    assert is_sensitive_path("config/private.pem")
    assert not is_sensitive_path(".env.example")
    assert not is_sensitive_path("app/config.py")


def test_redact_github_token():
    content = "token=github_pat_abcdefghijklmnopqrstuvwxyz0123456789"
    sanitized = redact_secrets(content)
    assert "github_pat_" not in sanitized
    assert "[REDACTED_SECRET]" in sanitized
