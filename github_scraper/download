# GitHub fine-grained personal access token.
# Optional for public repositories, required for private repositories.
GITHUB_TOKEN=github_pat_replace_me
GITHUB_API_VERSION=2026-03-10

# LLM used to create the structured repository summary.
OPENAI_API_KEY=sk-replace_me
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Analysis limits
MAX_ARCHIVE_BYTES=157286400
MAX_FILE_BYTES=1048576
MAX_SCANNED_FILES=1500
MAX_SUMMARY_FILES=120
MAX_FILE_CHARACTERS=24000
MAX_TOTAL_SUMMARY_CHARACTERS=350000
SUMMARY_BATCH_CHARACTERS=45000

# Cache summaries by repository commit SHA to avoid repeat model charges.
CACHE_ENABLED=true
CACHE_DIRECTORY=.cache
CACHE_TTL_SECONDS=86400

LOG_LEVEL=INFO
