# Add these values to the main project-management-tool/.env file.
# Keep GITHUB_TOKEN and OPENAI_API_KEY on the backend only.
GITHUB_TOKEN=github_pat_replace_me
GITHUB_API_VERSION=2026-03-10
GITHUB_SUMMARY_MODEL=gpt-5-mini

# Persistent Markdown artifacts and pgvector indexing.
DATABASE_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repository_summary
OUTPUT_DIRECTORY=artifacts
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=50
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=60
SUMMARY_CHUNK_TARGET_TOKENS=600
SUMMARY_CHUNK_OVERLAP_TOKENS=80
SUMMARY_CHUNK_MIN_TOKENS=80
GITHUB_SUMMARY_FORMAT_VERSION=2

# Optional analysis and cache limits.
GITHUB_SUMMARY_MAX_ARCHIVE_BYTES=157286400
GITHUB_SUMMARY_MAX_EXTRACTED_BYTES=524288000
GITHUB_SUMMARY_MAX_FILE_BYTES=1048576
GITHUB_SUMMARY_MAX_SCANNED_FILES=1500
GITHUB_SUMMARY_MAX_FILES=120
GITHUB_SUMMARY_MAX_FILE_CHARACTERS=24000
GITHUB_SUMMARY_MAX_CHARACTERS=350000
GITHUB_SUMMARY_BATCH_CHARACTERS=45000
GITHUB_SUMMARY_CACHE_ENABLED=true
GITHUB_SUMMARY_CACHE_DIRECTORY=.cache/github-summary
GITHUB_SUMMARY_CACHE_TTL_SECONDS=86400
